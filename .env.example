# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Edge Functions & Backend Integration (Server-side only)
# If provided, the Express backend proxies requests to live Supabase Edge Functions:
# - ${SUPABASE_URL}/functions/v1/passenger-lookup
# - ${SUPABASE_URL}/functions/v1/check-in
# - ${SUPABASE_URL}/functions/v1/check-out
SUPABASE_URL=""
SUPABASE_ANON_KEY=""

# Biometric Terminal Secret Token:
# Sent in the "x-device-token" header to Supabase Edge Functions.
# CRITICAL: Server-side only, NEVER expose to client-side bundle.
BIO_DEVICE_TOKEN=""

# Administrator Dashboard Access Passcode (Default: taporaa-admin-2026)
ADMIN_ACCESS_PASSCODE="taporaa-admin-2026"
